# Supabase session pooler (port 5432). Use the same value for both when the direct db host is IPv6-only.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
AUTH_SECRET="change-me-to-a-long-random-secret-in-production"
# Optional: leave empty to use local keyword matching without LLM calls
OPENAI_API_KEY=""
# Point at OpenAI, Azure OpenAI, OpenRouter, or a local Ollama OpenAI-compatible URL
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
NEXT_PUBLIC_APP_NAME="JobSeeker"
